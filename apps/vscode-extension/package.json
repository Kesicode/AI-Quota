{
    "name": "ai-quota",
    "displayName": "AI-Quota",
    "description": "Universal AI Account & Quota Manager — monitor quotas, manage accounts, and switch between AI providers directly from your IDE.",
    "version": "2.0.8",
    "publisher": "Kesicode",
    "license": "MIT",
    "homepage": "https://github.com/Kesicode/AI-Quota#readme",
    "bugs": {
        "url": "https://github.com/Kesicode/AI-Quota/issues"
    },
    "icon": "media/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/Kesicode/AI-Quota.git"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "node esbuild.js --production",
        "dev": "node esbuild.js --watch",
        "lint": "eslint src --ext ts",
        "package": "vsce package",
        "test": "node ./out/test/runTest.js"
    },
    "categories": [
        "Other",
        "Snippets"
    ],
    "keywords": [
        "ai",
        "quota",
        "antigravity",
        "account",
        "switcher",
        "gemini",
        "copilot",
        "codex"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "ai-quota-sidebar",
                    "title": "AI-Quota",
                    "icon": "media/quota-icon.svg"
                }
            ]
        },
        "views": {
            "ai-quota-sidebar": [
                {
                    "type": "webview",
                    "id": "ai-quota.quotaView",
                    "name": "Quota"
                },
                {
                    "id": "ai-quota.accountsView",
                    "name": "Accounts"
                },
                {
                    "id": "ai-quota.providersView",
                    "name": "Providers"
                }
            ]
        },
        "commands": [
            {
                "command": "ai-quota.openDashboard",
                "title": "AI-Quota: Open Dashboard",
                "icon": "$(dashboard)"
            },
            {
                "command": "ai-quota.switchAccount",
                "title": "AI-Quota: Switch Account",
                "icon": "$(account)"
            },
            {
                "command": "ai-quota.saveCurrentAccount",
                "title": "AI-Quota: Save Current Account"
            },
            {
                "command": "ai-quota.refresh",
                "title": "AI-Quota: Refresh Quota",
                "icon": "$(refresh)"
            },
            {
                "command": "ai-quota.showStatus",
                "title": "AI-Quota: Show Status"
            },
            {
                "command": "ai-quota.showDiagnostics",
                "title": "AI-Quota: Diagnostics"
            },
            {
                "command": "ai-quota.signIn",
                "title": "AI-Quota: Sign In"
            },
            {
                "command": "ai-quota.signOut",
                "title": "AI-Quota: Sign Out"
            },
            {
                "command": "ai-quota.reAuth",
                "title": "AI-Quota: Re-authenticate"
            },
            {
                "command": "ai-quota.showQuotaMatrix",
                "title": "AI-Quota: Quota Matrix (All Accounts)"
            },
            {
                "command": "ai-quota.addAccount",
                "title": "AI-Quota: Add Account"
            },
            {
                "command": "ai-quota.focusView",
                "title": "AI-Quota: Focus View"
            },
            {
                "command": "ai-quota.statusBarMenu",
                "title": "AI-Quota: Status Bar Menu"
            },
            {
                "command": "ai-quota.exportAccounts",
                "title": "AI-Quota: Export Saved Accounts..."
            },
            {
                "command": "ai-quota.importAccounts",
                "title": "AI-Quota: Import Saved Accounts..."
            },
            {
                "command": "ai-quota.exportAnalytics",
                "title": "AI-Quota: Export Quota Analytics..."
            },
            {
                "command": "ai-quota.restartBackend",
                "title": "AI-Quota: Restart Backend Process"
            },
            {
                "command": "ai-quota.clearTokenVault",
                "title": "AI-Quota: Clear Stored Token Vault..."
            },
            {
                "command": "ai-quota.openSettings",
                "title": "AI-Quota: Settings"
            },
            {
                "command": "ai-quota.showQuotaQuickPick",
                "title": "AI-Quota: Quick Quota View (QuickPick)",
                "icon": "$(pulse)"
            },
            {
                "command": "ai-quota.pinModelToStatusBar",
                "title": "AI-Quota: Pin Model to Status Bar",
                "icon": "$(pin)"
            },
            {
                "command": "ai-quota.unpinStatusBarModel",
                "title": "AI-Quota: Unpin Model from Status Bar",
                "icon": "$(pinned-dirty)"
            },
            {
                "command": "ai-quota.startBackend",
                "title": "AI-Quota: Start Local Engine",
                "icon": "$(play)"
            }
        ],
        "keybindings": [
            {
                "command": "ai-quota.statusBarMenu",
                "key": "alt+a",
                "mac": "alt+a"
            },
            {
                "command": "ai-quota.refresh",
                "key": "alt+shift+a",
                "mac": "alt+shift+a"
            },
            {
                "command": "ai-quota.showQuotaQuickPick",
                "key": "alt+q",
                "mac": "alt+q"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "ai-quota.openDashboard"
                },
                {
                    "command": "ai-quota.switchAccount"
                },
                {
                    "command": "ai-quota.saveCurrentAccount"
                },
                {
                    "command": "ai-quota.refresh"
                },
                {
                    "command": "ai-quota.showStatus"
                },
                {
                    "command": "ai-quota.showDiagnostics"
                },
                {
                    "command": "ai-quota.signIn"
                },
                {
                    "command": "ai-quota.signOut"
                },
                {
                    "command": "ai-quota.reAuth"
                },
                {
                    "command": "ai-quota.showQuotaMatrix"
                },
                {
                    "command": "ai-quota.addAccount"
                },
                {
                    "command": "ai-quota.focusView"
                },
                {
                    "command": "ai-quota.statusBarMenu"
                },
                {
                    "command": "ai-quota.exportAccounts"
                },
                {
                    "command": "ai-quota.importAccounts"
                },
                {
                    "command": "ai-quota.exportAnalytics"
                },
                {
                    "command": "ai-quota.restartBackend"
                },
                {
                    "command": "ai-quota.clearTokenVault"
                },
                {
                    "command": "ai-quota.openSettings"
                },
                {
                    "command": "ai-quota.showQuotaQuickPick"
                },
                {
                    "command": "ai-quota.pinModelToStatusBar"
                },
                {
                    "command": "ai-quota.unpinStatusBarModel"
                },
                {
                    "command": "ai-quota.startBackend"
                }
            ]
        },
        "configuration": {
            "title": "AI-Quota",
            "properties": {
                "ai-quota.agentUrl": {
                    "type": "string",
                    "default": "http://127.0.0.1:8765",
                    "description": "URL of the AI-Quota local agent."
                },
                "ai-quota.backendDir": {
                    "type": "string",
                    "default": "",
                    "description": "Absolute path to the AI-Quota backend folder (where run.bat and app/main.py live). Leave empty to auto-detect from the extension install location."
                },
                "ai-quota.pollInterval": {
                    "type": "number",
                    "default": 30,
                    "minimum": 5,
                    "maximum": 600,
                    "description": "Quota refresh interval in seconds."
                },
                "ai-quota.notificationThreshold": {
                    "type": "number",
                    "default": 20,
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Show low-quota notification when remaining % drops below this value."
                },
                "ai-quota.autoSwitch": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "**Auto-Switch on Low Quota**: When the active account's quota drops below `#ai-quota.notificationThreshold#`, automatically switch to the account with the most remaining quota. A cooldown prevents repeated switches. OFF by default — enable only if you trust automatic provider switching."
                },
                "ai-quota.autoSwitchCooldownMinutes": {
                    "type": "number",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 60,
                    "description": "Minimum minutes to wait between automatic account switches. Prevents switching back and forth repeatedly when quota is borderline."
                },
                "ai-quota.statusBarFormat": {
                    "type": "string",
                    "default": "$(pulse) AI-Quota {percent}% · {reset}",
                    "description": "Status bar format string. Supports {percent}, {reset}, {account}, {provider}."
                },
                "ai-quota.syncIntervalMinutes": {
                    "type": "number",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 60,
                    "description": "How often (in minutes) to run a full provider sync (port discovery + quota fetch). The fast UI poll (ai-quota.pollInterval) reads cached data only; this setting controls when actual quota data is fetched from providers."
                }
            }
        }
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "@types/vscode": "1.85",
        "@vscode/vsce": "^2.32.0",
        "esbuild": "^0.21.5",
        "eslint": "^8.57.0",
        "typescript": "5.4"
    }
}